{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/lib/calculators/**/*.ts",
    "src/lib/seo/site.ts",
    "src/lib/seo/site.test.ts",
    "src/components/calculators/presentation.ts",
    "src/components/calculators/presentation.test.ts",
    "src/content/calculators/**/*.ts"
  ]
}
