{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-project-calculators",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENABLE_PRODUCTION_REDIRECTS": "false"
  },
  "routes": [
    {
      "pattern": "projectbuylist.com",
      "custom_domain": true
    },
    {
      "pattern": "www.projectbuylist.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
